<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.interfaceconfig.infrastructure.persistence.InterfaceServiceCallLogMapper">

    <resultMap id="InterfaceServiceCallLogResultMap" type="com.lingdong.learning.interfaceconfig.domain.InterfaceServiceCallLog">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="service_id" javaType="java.lang.Long"/>
            <arg column="caller_name" javaType="java.lang.String"/>
            <arg column="result" javaType="com.lingdong.learning.interfaceconfig.domain.InterfaceCallResult"/>
            <arg column="error_summary" javaType="java.lang.String"/>
            <arg column="trace_id" javaType="java.lang.String"/>
            <arg column="occurred_at" javaType="java.time.LocalDateTime"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <insert id="insert">
        INSERT INTO sys_interface_call_log (
            id, service_id, caller_name, result, error_summary, trace_id, occurred_at
        ) VALUES (
            #{callLog.id}, #{callLog.serviceId}, #{callLog.callerName}, #{callLog.result},
            #{callLog.errorSummary, jdbcType=VARCHAR}, #{callLog.traceId, jdbcType=VARCHAR}, #{callLog.occurredAt}
        )
    </insert>

    <select id="findById" resultMap="InterfaceServiceCallLogResultMap">
        SELECT id, service_id, caller_name, result, error_summary, trace_id, occurred_at, created_at
        FROM sys_interface_call_log
        WHERE id = #{id}
    </select>
</mapper>
