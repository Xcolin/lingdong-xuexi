<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.feature.infrastructure.persistence.FeatureToggleChangeMapper">
 <resultMap id="ChangeMap" type="com.lingdong.learning.feature.application.FeatureToggleChange"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="task_id" javaType="java.lang.Long"/><arg column="feature_code" javaType="java.lang.String"/><arg column="target_status" javaType="com.lingdong.learning.feature.domain.FeatureStatus"/><arg column="before_status" javaType="com.lingdong.learning.feature.domain.FeatureStatus"/><arg column="base_version" javaType="java.lang.Long"/></constructor></resultMap>
 <insert id="insert">INSERT INTO sys_feature_toggle_change(id,task_id,feature_code,target_status,before_status,base_version) VALUES(#{change.id},#{change.taskId},#{change.featureCode},#{change.targetStatus},#{change.beforeStatus,jdbcType=VARCHAR},#{change.baseVersion,jdbcType=BIGINT})</insert>
 <select id="findByTaskId" resultMap="ChangeMap">SELECT id,task_id,feature_code,target_status,before_status,base_version FROM sys_feature_toggle_change WHERE task_id=#{taskId}</select>
</mapper>
