<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.dictionary.infrastructure.persistence.DictionaryTypeMapper">

    <resultMap id="DictionaryTypeResultMap" type="com.lingdong.learning.dictionary.domain.DictionaryType">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="type_code" javaType="java.lang.String"/>
            <arg column="type_name" javaType="java.lang.String"/>
            <arg column="status" javaType="com.lingdong.learning.dictionary.domain.DictionaryStatus"/>
            <arg column="sort_order" javaType="java.lang.Integer"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="DictionaryTypeColumns">id, type_code, type_name, status, sort_order, created_at, updated_at</sql>

    <select id="findById" resultMap="DictionaryTypeResultMap">
        SELECT <include refid="DictionaryTypeColumns"/>
        FROM sys_dictionary_type
        WHERE id = #{id}
    </select>

    <select id="findByIdForUpdate" resultMap="DictionaryTypeResultMap">
        SELECT <include refid="DictionaryTypeColumns"/>
        FROM sys_dictionary_type
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <select id="findByCode" resultMap="DictionaryTypeResultMap">
        SELECT <include refid="DictionaryTypeColumns"/>
        FROM sys_dictionary_type
        WHERE type_code = #{code}
    </select>

    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS(
            SELECT 1
            FROM sys_dictionary_type
            WHERE type_code = #{code}
        )
    </select>

    <update id="update">
        UPDATE sys_dictionary_type
        SET type_name = #{dictionaryType.name},
            status = #{dictionaryType.status},
            sort_order = #{dictionaryType.sortOrder},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{dictionaryType.id}
    </update>

    <insert id="insert">
        INSERT INTO sys_dictionary_type (type_code, type_name, status, sort_order)
        VALUES (#{dictionaryType.code}, #{dictionaryType.name}, #{dictionaryType.status}, #{dictionaryType.sortOrder})
    </insert>
</mapper>
