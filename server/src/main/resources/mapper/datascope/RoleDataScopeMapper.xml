<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.lingdong.learning.datascope.infrastructure.persistence.RoleDataScopeMapper"><select id="findOrganizationIds" resultType="long">SELECT organization_id FROM sys_role_data_scope WHERE role_id=#{roleId}</select><select id="exists" resultType="boolean">SELECT EXISTS(SELECT 1 FROM sys_role_data_scope WHERE role_id=#{roleId} AND organization_id=#{organizationId})</select><insert id="insert">INSERT INTO sys_role_data_scope(role_id,organization_id) VALUES(#{roleId},#{organizationId})</insert></mapper>
