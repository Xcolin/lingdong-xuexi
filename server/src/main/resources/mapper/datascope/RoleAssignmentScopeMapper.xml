<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.lingdong.learning.datascope.infrastructure.persistence.RoleAssignmentScopeMapper"><resultMap id="ScopeMap" type="com.lingdong.learning.datascope.application.RoleAssignmentScope"><constructor><idArg column="role_id" javaType="java.lang.Long"/><arg column="data_scope" javaType="com.lingdong.learning.iam.domain.RoleDataScope"/><arg column="organization_id" javaType="java.lang.Long"/></constructor></resultMap><select id="findByUserId" resultMap="ScopeMap">SELECT r.id AS role_id,r.data_scope,ur.organization_id FROM sys_user_role ur JOIN sys_role r ON r.id=ur.role_id WHERE ur.user_id=#{userId} AND r.status='ENABLED'</select></mapper>
