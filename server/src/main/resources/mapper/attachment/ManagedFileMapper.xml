<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.attachment.infrastructure.persistence.ManagedFileMapper">
 <resultMap id="FileMap" type="com.lingdong.learning.attachment.domain.ManagedFileRecord"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="storage_key" javaType="java.lang.String"/><arg column="original_name" javaType="java.lang.String"/><arg column="extension" javaType="java.lang.String"/><arg column="content_type" javaType="java.lang.String"/><arg column="size_bytes" javaType="java.lang.Long"/><arg column="uploader_id" javaType="java.lang.Long"/><arg column="status" javaType="com.lingdong.learning.attachment.domain.FileStatus"/><arg column="uploaded_at" javaType="java.time.LocalDateTime"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
 <insert id="insert">INSERT INTO sys_file(id,storage_key,original_name,extension,content_type,size_bytes,uploader_id,status) VALUES(#{file.id},#{file.storageKey},#{file.originalName},#{file.extension},#{file.contentType},#{file.sizeBytes},#{file.uploaderId},#{file.status})</insert>
 <select id="findById" resultMap="FileMap">SELECT id,storage_key,original_name,extension,content_type,size_bytes,uploader_id,status,uploaded_at,created_at,updated_at FROM sys_file WHERE id=#{id}</select>
 <update id="markAvailable">UPDATE sys_file SET status='AVAILABLE',uploaded_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=#{id} AND status='UPLOADING'</update>
</mapper>
