<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.attachment.infrastructure.persistence.ManagedFileMapper">
 <resultMap id="FileMap" type="com.lingdong.learning.attachment.domain.ManagedFileRecord"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="storage_key" javaType="java.lang.String"/><arg column="original_name" javaType="java.lang.String"/><arg column="extension" javaType="java.lang.String"/><arg column="content_type" javaType="java.lang.String"/><arg column="size_bytes" javaType="java.lang.Long"/><arg column="uploader_id" javaType="java.lang.Long"/><arg column="module_code" javaType="java.lang.String"/><arg column="file_category" javaType="java.lang.String"/><arg column="content_sha256" javaType="java.lang.String"/><arg column="status" javaType="com.lingdong.learning.attachment.domain.FileStatus"/><arg column="uploaded_at" javaType="java.time.LocalDateTime"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
 <resultMap id="LedgerMap" type="com.lingdong.learning.attachment.application.AttachmentFileLedgerView">
  <constructor>
   <idArg column="id" javaType="java.lang.Long"/>
   <arg column="original_name" javaType="java.lang.String"/>
   <arg column="extension" javaType="java.lang.String"/>
   <arg column="content_type" javaType="java.lang.String"/>
   <arg column="size_bytes" javaType="java.lang.Long"/>
   <arg column="uploader_id" javaType="java.lang.Long"/>
   <arg column="uploader_name" javaType="java.lang.String"/>
   <arg column="module_code" javaType="java.lang.String"/>
   <arg column="file_category" javaType="java.lang.String"/>
   <arg column="content_sha256_present" javaType="boolean"/>
   <arg column="status" javaType="com.lingdong.learning.attachment.domain.FileStatus"/>
   <arg column="uploaded_at" javaType="java.time.LocalDateTime"/>
   <arg column="created_at" javaType="java.time.LocalDateTime"/>
   <arg column="updated_at" javaType="java.time.LocalDateTime"/>
  </constructor>
 </resultMap>
 <insert id="insert">INSERT INTO sys_file(id,storage_key,original_name,extension,content_type,size_bytes,uploader_id,module_code,file_category,status) VALUES(#{file.id},#{file.storageKey},#{file.originalName},#{file.extension},#{file.contentType},#{file.sizeBytes},#{file.uploaderId},#{file.moduleCode},#{file.fileCategory},#{file.status})</insert>
 <select id="findById" resultMap="FileMap">SELECT id,storage_key,original_name,extension,content_type,size_bytes,uploader_id,module_code,file_category,content_sha256,status,uploaded_at,created_at,updated_at FROM sys_file WHERE id=#{id}</select>
 <select id="findLedger" resultMap="LedgerMap">
  SELECT file.id, file.original_name, file.extension, file.content_type, file.size_bytes,
         file.uploader_id, uploader.display_name AS uploader_name, file.module_code,
         file.file_category,
         CASE WHEN file.content_sha256 IS NULL THEN 0 ELSE 1 END AS content_sha256_present,
         file.status, file.uploaded_at, file.created_at, file.updated_at
  FROM sys_file file
  JOIN sys_user uploader ON uploader.id = file.uploader_id
  <where>
   <if test="originalName != null">AND file.original_name LIKE CONCAT('%', #{originalName}, '%')</if>
   <if test="moduleCode != null">AND file.module_code = #{moduleCode}</if>
   <if test="fileCategory != null">AND file.file_category = #{fileCategory}</if>
   <if test="status != null">AND file.status = #{status}</if>
   <if test="uploaderId != null">AND file.uploader_id = #{uploaderId}</if>
   <if test="createdFrom != null">AND file.created_at &gt;= #{createdFrom}</if>
   <if test="createdTo != null">AND file.created_at &lt;= #{createdTo}</if>
  </where>
  ORDER BY file.created_at DESC, file.id DESC
  LIMIT 200
 </select>
 <update id="markAvailable">UPDATE sys_file SET status='AVAILABLE',content_sha256=#{contentSha256},uploaded_at=CURRENT_TIMESTAMP,updated_at=CURRENT_TIMESTAMP WHERE id=#{id} AND status='UPLOADING'</update>
 <update id="markRetired">UPDATE sys_file SET status='RETIRED',updated_at=CURRENT_TIMESTAMP WHERE id=#{id} AND status='AVAILABLE'</update>
</mapper>
