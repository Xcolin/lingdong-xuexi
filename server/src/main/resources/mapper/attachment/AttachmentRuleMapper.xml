<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.attachment.infrastructure.persistence.AttachmentRuleMapper">
 <resultMap id="RuleMap" type="com.lingdong.learning.attachment.domain.AttachmentRuleRecord"><constructor><idArg column="id" javaType="java.lang.Long"/><arg column="module_code" javaType="java.lang.String"/><arg column="file_category" javaType="java.lang.String"/><arg column="rule_name" javaType="java.lang.String"/><arg column="max_file_size_bytes" javaType="long"/><arg column="max_batch_count" javaType="int"/><arg column="preview_enabled" javaType="boolean"/><arg column="download_scope" javaType="java.lang.String"/><arg column="status" javaType="com.lingdong.learning.attachment.domain.AttachmentRuleStatus"/><arg column="created_at" javaType="java.time.LocalDateTime"/><arg column="updated_at" javaType="java.time.LocalDateTime"/></constructor></resultMap>
 <insert id="insert">INSERT INTO sys_attachment_rule(id,module_code,file_category,rule_name,max_file_size_bytes,max_batch_count,preview_enabled,download_scope,status) VALUES(#{rule.id},#{rule.moduleCode},#{rule.fileCategory},#{rule.ruleName},#{rule.maxFileSizeBytes},#{rule.maxBatchCount},#{rule.previewEnabled},#{rule.downloadScope},#{rule.status})</insert>
 <select id="findById" resultMap="RuleMap">SELECT id,module_code,file_category,rule_name,max_file_size_bytes,max_batch_count,preview_enabled,download_scope,status,created_at,updated_at FROM sys_attachment_rule WHERE id=#{id}</select>
 <select id="findByModuleAndCategory" resultMap="RuleMap">SELECT id,module_code,file_category,rule_name,max_file_size_bytes,max_batch_count,preview_enabled,download_scope,status,created_at,updated_at FROM sys_attachment_rule WHERE module_code=#{moduleCode} AND file_category=#{fileCategory}</select>
 <update id="updateStatus">UPDATE sys_attachment_rule SET status=#{status},updated_at=CURRENT_TIMESTAMP WHERE id=#{id}</update>
</mapper>
