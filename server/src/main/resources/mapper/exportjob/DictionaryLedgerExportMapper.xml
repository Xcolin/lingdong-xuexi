<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingdong.learning.exportjob.infrastructure.persistence.DictionaryLedgerExportMapper">
    <resultMap id="RowMap" type="com.lingdong.learning.exportjob.infrastructure.persistence.DictionaryLedgerExportRow">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="type_code" javaType="java.lang.String"/>
            <arg column="type_name" javaType="java.lang.String"/>
            <arg column="item_code" javaType="java.lang.String"/>
            <arg column="item_name" javaType="java.lang.String"/>
            <arg column="sort_order" javaType="java.lang.Integer"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="updated_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>
    <sql id="source">
        FROM sys_dictionary_item i JOIN sys_dictionary_type t ON t.id = i.type_id
        WHERE 1 = 1
        <if test="request.dictionaryTypeCode != null">AND t.type_code = #{request.dictionaryTypeCode}</if>
        <if test="request.dictionaryStatus != null">AND i.status = #{request.dictionaryStatus}</if>
        <if test="request.startedAt != null">AND i.updated_at &gt;= #{request.startedAt}</if>
        <if test="request.endedAt != null">AND i.updated_at &lt;= #{request.endedAt}</if>
    </sql>
    <select id="findUpperBound" resultType="java.lang.Long">
        SELECT MAX(i.id) <include refid="source"/>
    </select>
    <select id="count" resultType="long">
        SELECT COUNT(1) <include refid="source"/> AND i.id &lt;= #{upperBound}
    </select>
    <select id="findAfter" resultMap="RowMap">
        SELECT i.id, t.type_code, t.type_name, i.item_code, i.item_name, i.sort_order, i.status, i.updated_at
        <include refid="source"/>
        AND i.id &gt; #{cursor} AND i.id &lt;= #{upperBound}
        ORDER BY i.id LIMIT #{limit}
    </select>
</mapper>
